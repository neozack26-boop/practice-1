# =============================================================================
# StudyLoop — Supabase & Database Environment Configuration
# =============================================================================

# 1. Supabase Project URL & Keys
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Supabase Direct Database Connection (For Node.js Migration Runner via 'pg')
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection String URI
# Format (Session / Direct on port 5432):
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Alternatively, you can provide the DB password and the migration runner will construct the URI:
# SUPABASE_DB_PASSWORD=your_actual_db_password

# 3. Optional: Supabase Personal Access Token (for Supabase Management API)
# Found in: https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_...

# 4. App / Express Server Configuration (Phase 2)
PORT=5000
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=your-gemini-api-key

