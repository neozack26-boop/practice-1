{
  "name": "studyloop-supabase-migrations",
  "version": "1.0.0",
  "description": "Supabase PostgreSQL migration runner, schema definitions, and seed scripts for StudyLoop",
  "main": "scripts/migrate.js",
  "type": "module",
  "scripts": {
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "verify": "node scripts/verify.js",
    "setup": "node scripts/migrate.js && node scripts/seed.js && node scripts/verify.js",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "start:server": "npm --prefix server run start"
  },
  "keywords": [
    "supabase",
    "postgresql",
    "migrations",
    "studyloop",
    "rls"
  ],
  "author": "StudyLoop Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.3"
  }
}

